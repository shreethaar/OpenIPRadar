{
  "Scanning": {
    "MaxConcurrency": 4,
    "HttpTimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryBaseDelayMs": 500
  },
  "Providers": {
    "AbuseIPDB": {
      "Enabled": true,
      "BaseUrl": "https://api.abuseipdb.com/api/v2/",
      "CheckPath": "check",
      "MaxAgeInDays": 90,
      "RequestsPerMinute": 60
    },
    "VirusTotal": {
      "Enabled": true,
      "BaseUrl": "https://www.virustotal.com/api/v3/",
      "IpLookupPath": "ip_addresses/",
      "RequestsPerMinute": 4
    },
    "Shodan": {
      "Enabled": false,
      "BaseUrl": "https://api.shodan.io/",
      "HostPath": "shodan/host/",
      "ApiInfoPath": "api-info",
      "RequestsPerMinute": 60
    }
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Directory": "%AppData%/OpenIPRadar/logs"
  }
}
