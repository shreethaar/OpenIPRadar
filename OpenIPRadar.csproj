<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenIPRadar</RootNamespace>
    <AssemblyName>OpenIPRadar</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required by project convention; suppress "missing doc" noise only for generated/partial members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- QuestPDF is the ONLY external dependency, isolated behind IReportExporter (PdfReportExporter). -->
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
